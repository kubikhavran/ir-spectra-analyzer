# QA test artifacts
tests/qa_screenshots/
tests/fixtures/reference library_1/
# Analysed projects used to validate functional-group scoring. They carry the
# SMILES of unpublished compounds and customer names — local only.
tests/fixtures/irproj test/
# Same reason: a customer sample, kept only as a local regression fixture for
# the Y-unit guard. tests/test_y_unit_check.py skips without it, and the parse
# rule itself is covered by synthetic history text.
tests/fixtures/JUS251-SE.SPA
# 16 MB of unpublished ATR measurements, kept locally to check the display-unit
# work against real absorbance spectra. tests/test_display_unit.py builds its
# own curves, so nothing in CI depends on them.
tests/fixtures/ATR.zip

